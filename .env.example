# Generate 32+ random characters. For testing, do not reuse account credentials.
ALERT_KEY=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
PORT=8787
EXPECTED_EXCHANGE=NSE
EXPECTED_TICKER=NIFTY
# Optional comma-separated allowlist for both indices; overrides EXPECTED_EXCHANGE/TICKER.
# EXPECTED_SYMBOLS=NSE:NIFTY,BSE:SENSEX
# Use your actual TradingView chart's timeframe, e.g., 1, 3, 5. Empty means don't restrict.
EXPECTED_INTERVAL=
# Safety controls for accepted signals (NOT trades)
MAX_SIGNALS_PER_DAY=6
MAX_DELIVERY_AGE_SECONDS=120
# Keep false except during intentional after-hours paper-only diagnostics.
ALLOW_AFTERHOURS_PAPER=false
# 60-second screenshots of user-visible browser tabs; local files only.
SCREENSHOT_SECONDS=60

# =====================================================================
# Python behavioral engine (app/) -- milestones M0-M2
# =====================================================================
# Paper trading only. There is no supported value other than PAPER.
TRADING_MODE=PAPER
# Shared secret for the TradingView webhook URL path. 32+ random characters.
# PowerShell: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToHexString($b)
WEBHOOK_TOKEN=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
API_HOST=127.0.0.1
API_PORT=8788
MAX_BODY_BYTES=8192
# Must match the indicator name exactly as published on TradingView.
EXPECTED_INDICATOR=Half Trend Regression [AlgoAlpha]
ALLOWED_SYMBOLS=NSE:NIFTY
# Canonical timeframe labels. TradingView's "5" is normalized to "5m".
ALLOWED_TIMEFRAMES=1m,3m,5m,15m
# Four independent budgets. They answer different questions; do not reuse one
# value for several of them.
#  - how late a delivery may be and still be allowed to open a paper position
MAX_TRADABLE_AGE_SECONDS=120
#  - how late a delivery may be and still be recorded for analysis. Beyond this
#    the event is rejected outright.
MAX_RECORDABLE_AGE_SECONDS=900
#  - how far a timestamp may sit in the future before it is a clock fault
CLOCK_SKEW_TOLERANCE_SECONDS=10
#  - how far before its own bar close an alert may claim to have fired. This is
#    candle alignment, not delivery: a slow network says nothing about whether
#    a bar had closed.
BAR_CLOSE_TOLERANCE_SECONDS=5
DATABASE_PATH=data/engine.db
HOLIDAY_FILE=data/reference/nse_calendar.json

# =====================================================================
# Market-data credentials (M3). Absent means LIVE BLOCKED, never degraded
# live operation. These are read from the environment only and are
# registered with the log redactor at startup, so they cannot reach a log.
# Leave blank unless you are running the live smoke test.
# =====================================================================
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=
FYERS_ACCESS_TOKEN=
# Preferred: free, read-only, 1-year, no static IP. Generate on the Upstox
# Developer Apps page (Analytics tab). Falls back to UPSTOX_ACCESS_TOKEN.
UPSTOX_ANALYTICS_TOKEN=
